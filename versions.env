# Bash 版本清单。修改后运行 bash scripts/sync-versions.sh --write 更新 Dockerfile 默认值。

# openjdk
export TEMURIN_RELEASE=11.0.23
export TEMURIN_BUILD=9
export OPENJDK_TAG_PREFIX="v${TEMURIN_RELEASE//./_}-jdk-ubi9"
export OPENJDK_TAG_AMD64="${OPENJDK_TAG_PREFIX}-x86"
export OPENJDK_TAG_ARM64="${OPENJDK_TAG_PREFIX}-arm64"
export TEMURIN_BASE_IMAGE="eclipse-temurin:${TEMURIN_RELEASE}_${TEMURIN_BUILD}-jdk-ubi9-minimal"
export CORRETTO_11_TAG=11-alpine3.19-jdk
export CORRETTO_8_TAG=8-alpine3.22-jdk
export LIBREOFFICE_RPM_VERSION=7.5.9.2
export OPENJDK_IMAGE_AMD64="dockerhub.qingcloud.com/tsingyun_middleware/tsingyun-openjdk:${OPENJDK_TAG_AMD64}"
export OPENJDK_IMAGE_ARM64="dockerhub.qingcloud.com/tsingyun_middleware/tsingyun-openjdk:${OPENJDK_TAG_ARM64}"

# apollo
export APOLLO_PORTAL_UNPACK_IMAGE=alpine:3.15.5
export APOLLO_PORTAL_JRE_IMAGE=openjdk:8-jre-slim
