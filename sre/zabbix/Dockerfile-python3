# 基于官方zabbix server镜像 (Ubuntu)
FROM zabbix/zabbix-server-pgsql:7.0-ubuntu-latest

# 暂时切换到root用户
USER root

# 更新包列表和安装 Python 及其依赖，使用阿里云加速镜像安装 requests
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y python3 python3-pip python3-requests

# 确认Python和pip版本
RUN python3 --version && pip3 --version

# 切换回zabbix用户
USER zabbix

# 保留CMD配置
CMD ["/usr/sbin/zabbix_server", "--foreground", "-c", "/etc/zabbix/zabbix_server.conf"]
