version: '3'

services:
  kafka:
    image: dockerhub.qingcloud.com/tsingyun_middleware/kafka-kraft:3.9.1-arm64
    container_name: kafka
    environment:
      #KAFKA_LISTENERS: PLAINTEXT://:9092 # Kafka 监听端口配置
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://172.16.10.180:9092 # Kafka 对外公布的地址
      #KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT # 监听器与安全协议的映射
      #KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT # Broker 间通信使用的监听器
    ports:
      - "9092:9092"
    volumes:
      #日志目录
      - /home/application/Middleware/kafka/logs:/opt/kafka/logs
      #数据目录
      - /home/application/Middleware/kafka/data:/tmp/kraft-combined-logs
    restart: always
    healthcheck:
      test: ["CMD", "nc", "-z", "127.0.0.1", "9092"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    networks:
      - tsingyun

  kafka-map: 
    image: dockerhub.qingcloud.com/tsingyun_middleware/kafka-map:1.3.3-arm64
    container_name: kafka-map
    networks:
      - tsingyun
    volumes:
      - "/home/application/Middleware/kafka/kafka-map/data:/usr/local/kafka-map/data"  
    ports:
      - 19006:8080
    environment:
      DEFAULT_USERNAME: admin
      DEFAULT_PASSWORD: xxxx
    depends_on:
      - kafka
    restart: 'unless-stopped'
    
    
networks:
  tsingyun:
    external: true