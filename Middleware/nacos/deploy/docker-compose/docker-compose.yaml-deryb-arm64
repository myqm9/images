networks:
  tsingyun:
    driver: bridge

services:
  nacos:
    image: dockerhub.qingcloud.com/tsingyun_middleware/tsingyun-nacos:2.5.3-arm64
    container_name: nacos
    networks:
      - tsingyun
    restart: always
    ports:
      # web 界面访问端口
      - 8848:8848
      # 程序使用 grpc 连接的端口
      - 9848:9848
    environment:
      - MODE=standalone
      - NACOS_AUTH_ENABLE=true
      - NACOS_AUTH_TOKEN=u2n9mtaRRQuZ0ukPWs542yAVQCMP9upuWwrxTTXlO9hBb6nVDTjOOLQKJww3a
      - NACOS_AUTH_IDENTITY_KEY=serverIdentity
      - NACOS_AUTH_IDENTITY_VALUE=39!=5TU#R;mJoF.B9#*+Axer*5LFht4T
    volumes:
      - ./logs:/home/nacos/logs
      - ./data:/home/nacos/data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8848/nacos/actuator/health"]
      interval: 30s
      retries: 3
      start_period: 10s
      timeout: 10s