services:
  redis:
    image: harbor.tsingyun.net/tsingyun-middleware/redis:8.10.1-arm64
    container_name: redis
    networks:
      - tsingyun
    restart: always
    command: redis-server --requirepass XXXXXXXX --port 6379 --appendonly yes --dbfilename dump.rd --dir /data --timeout 0 --save 900 1 --save 300 10 --save 60 10000
    volumes:
      - /home/application/Database/redis/data:/data
      - /home/application/Database/redis/logs:/logs
    ports:
      - 6379:6379
    healthcheck:
      test: ["CMD", "redis-cli", "-h", "127.0.0.1", "-p", "6379", "-a", "XXXXXXXX", "ping"]
      interval: 30s
      retries: 3
      start_period: 30s
      timeout: 10s


networks:
  tsingyun:
    external: true