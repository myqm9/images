---

<button class="tdp-share-page" type="button" data-share-page aria-live="polite">
  <span class="tdp-share-page__idle">
    <svg class="tdp-share-page__icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="18" cy="5" r="2.35" fill="currentColor"></circle>
      <circle cx="6" cy="12" r="2.35" fill="currentColor"></circle>
      <circle cx="18" cy="19" r="2.35" fill="currentColor"></circle>
      <path
        d="M8.2 10.7 15.7 6.4M8.2 13.3l7.5 4.3"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      ></path>
    </svg>
    分享此页面
  </span>
  <span class="tdp-share-page__done">
    <svg class="tdp-share-page__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M2 21h4V9H2v12zm20.8-11.2c0-1.1-.9-2-2-2h-6.3l.9-4.6c.1-.5-.1-1-.5-1.4L14.2 1 7.6 7.6C7.2 8 7 8.5 7 9v10c0 1.1.9 2 2 2h9c.8 0 1.5-.5 1.8-1.2l3-7.1c.1-.2.1-.5.1-.7v-2.2z"
      ></path>
    </svg>
    链接已复制
  </span>
</button>

<script>
  const copyPageUrl = async () => {
    const url = `${location.origin}${location.pathname}${location.search}`;
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(url);
      return;
    }
    const textarea = document.createElement('textarea');
    textarea.value = url;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();
    document.execCommand('copy');
    textarea.remove();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-share-page]').forEach((button) => {
    let resetTimer: number | undefined;
    const setCopied = (copied: boolean) => {
      button.classList.toggle('is-copied', copied);
      button.setAttribute('aria-label', copied ? '链接已复制' : '复制当前页面链接');
    };

    setCopied(false);
    button.addEventListener('click', async () => {
      try {
        await copyPageUrl();
        setCopied(true);
        if (resetTimer) window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => setCopied(false), 2000);
      } catch {
        button.classList.add('is-failed');
        window.setTimeout(() => button.classList.remove('is-failed'), 1600);
      }
    });
  });
</script>
