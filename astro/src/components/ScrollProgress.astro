---
---

<button class="tdp-scroll-progress" type="button" data-scroll-progress aria-label="回到顶部">
  <svg class="tdp-scroll-progress__ring" viewBox="0 0 48 48" aria-hidden="true">
    <circle class="tdp-scroll-progress__track" cx="24" cy="24" r="20"></circle>
    <circle class="tdp-scroll-progress__bar" cx="24" cy="24" r="20"></circle>
  </svg>
  <span class="tdp-scroll-progress__value" data-scroll-progress-value>0</span>
</button>

<script>
  const radius = 20;
  const circumference = 2 * Math.PI * radius;
  const button = document.querySelector<HTMLButtonElement>('[data-scroll-progress]');
  const bar = button?.querySelector<SVGCircleElement>('.tdp-scroll-progress__bar');
  const value = button?.querySelector<HTMLElement>('[data-scroll-progress-value]');

  if (button && bar && value) {
    document.body.append(button);
    bar.style.strokeDasharray = `${circumference}`;
    bar.style.strokeDashoffset = `${circumference}`;

    const update = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(100, Math.round((scrollTop / max) * 100)) : 0;
      bar.style.strokeDashoffset = `${circumference * (1 - progress / 100)}`;
      value.textContent = String(progress);
      button.classList.toggle('is-visible', scrollTop > 48);
    };

    const scrollToTop = (event: Event) => {
      event.preventDefault();
      event.stopPropagation();
      window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    button.addEventListener('click', scrollToTop);
    button.addEventListener('pointerdown', (event) => event.stopPropagation());
  }
</script>
