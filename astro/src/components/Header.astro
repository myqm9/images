---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import DisplaySettings from './DisplaySettings.astro';

const shouldRenderSearch =
  Astro.url.pathname !== '/' &&
  (config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro');
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <a class="site-logo" href="/" aria-label="TDP 首页"><img src="/images/tdp-logo.png" alt="Tsingyun Intelligence" width="184" height="64" /></a>
  </div>
  <div class="header-search sl-flex print:hidden">{shouldRenderSearch && <Search />}</div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons"><SocialIcons /></div>
    <DisplaySettings />
    <LanguageSelect />
  </div>
</div>

<script>
  const pageHeader = document.querySelector<HTMLElement>('.page > header.header');
  const updateHeaderState = () => pageHeader?.classList.toggle('is-scrolled', window.scrollY > 8);
  updateHeaderState();
  window.addEventListener('scroll', updateHeaderState, { passive: true });

  // Starlight 的自动目录分组本身不是链接。让 Middleware 标题进入汇总页，点击箭头仍保留展开/收起行为。
  const middlewareSummary = Array.from(document.querySelectorAll<HTMLElement>('nav.sidebar summary')).find(
    (summary) => summary.querySelector('.large')?.textContent?.trim() === 'Middleware',
  );
  middlewareSummary?.setAttribute('title', '进入 Middleware 组件目录');
  middlewareSummary?.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest('svg')) return;
    event.preventDefault();
    window.location.assign('/middleware/');
  });

  const copyText = async (value: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return;
    }
    const textarea = document.createElement('textarea');
    textarea.value = value;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();
    document.execCommand('copy');
    textarea.remove();
  };

  const COPY_SELECTOR = 'button.catalog-copy';
  let copyToast: HTMLDivElement | undefined;
  let copyToastTimer: number | undefined;
  const showCopyToast = (message: string, state: 'success' | 'error') => {
    if (!copyToast) {
      copyToast = document.createElement('div');
      copyToast.className = 'tdp-copy-toast';
      copyToast.setAttribute('role', 'status');
      copyToast.setAttribute('aria-live', 'polite');
      document.body.append(copyToast);
    }
    copyToast.textContent = message;
    copyToast.dataset.state = state;
    copyToast.classList.add('is-visible');
    if (copyToastTimer) window.clearTimeout(copyToastTimer);
    copyToastTimer = window.setTimeout(() => copyToast?.classList.remove('is-visible'), 2200);
  };

  const copyImageRef = async (button: HTMLButtonElement) => {
    const value = button.dataset.copy?.trim();
    if (!value) return;
    try {
      await copyText(value);
      button.dataset.copyState = 'copied';
      showCopyToast('镜像地址已复制', 'success');
      window.setTimeout(() => delete button.dataset.copyState, 1800);
    } catch {
      button.dataset.copyState = 'failed';
      showCopyToast('复制失败，请手动复制', 'error');
      window.setTimeout(() => delete button.dataset.copyState, 1800);
    }
  };

  document.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>(COPY_SELECTOR) : null;
    if (!button) return;
    event.preventDefault();
    void copyImageRef(button);
  });
</script>

<style>
  @layer starlight.core {
    .header { display: flex; gap: var(--sl-nav-gap); justify-content: space-between; align-items: center; height: 100%; }
    .title-wrapper { overflow: clip; padding: .25rem; margin: -.25rem; min-width: 0; }
    .site-logo { display: block; line-height: 0; }
    .site-logo img { width: 11rem; height: 3.75rem; object-fit: contain; }
    .header-search { align-items: center; justify-self: start; margin-inline-start: 1rem; }
    :global(.header-search button[data-open-modal]) { width: auto; max-width: none; height: 1.9rem; gap: .48rem; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--sl-color-gray-2); font-size: .84rem; }
    :global(.header-search button[data-open-modal]:hover) { border: 0; color: var(--sl-color-text-accent); }
    :global(.header-search button[data-open-modal] svg) { width: .9rem; height: .9rem; }
    :global(.header-search button[data-open-modal] > kbd) { display: inline-flex !important; align-items: center; min-width: 2.05rem; margin-inline-start: .3rem; padding: .15rem .35rem; border: 1px solid var(--sl-color-gray-5); border-radius: .28rem; background: color-mix(in srgb, var(--sl-color-bg) 88%, var(--sl-color-gray-5)); color: var(--sl-color-gray-2); font-size: .7rem; line-height: 1; }
    :global(.header-search button[data-open-modal] > kbd kbd) { padding: 0; background: transparent; }
    .right-group, .social-icons { gap: .8rem; align-items: center; }
    @media (min-width: 50rem) {
      :global(:root[data-has-sidebar]) { --__sidebar-pad: calc(2 * var(--sl-nav-pad-x)); }
      :global(:root:not([data-has-toc])) { --__toc-width: 0rem; }
      .header { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-content: center; }
    }
  }
</style>
