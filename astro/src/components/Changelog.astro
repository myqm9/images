---
import { isCurrentVersion, loadVersionInfo } from '../lib/version.mjs';

const { version, entries, batchCount, latestDate } = loadVersionInfo();

const stats = [
  { label: '当前版本', value: version || '—' },
  { label: '已记录批次', value: String(batchCount) },
  { label: '最近更新', value: latestDate || '—' },
];
---

<section class="catalog-intro changelog-intro not-content">
  <div class="changelog-intro__copy">
    <p class="catalog-eyebrow">TDP · RELEASE NOTES</p>
    <h1>更新日志</h1>
    <p>记录 TDP 镜像构建、组件升级与文档站交付的每一次变更。内容由仓库根目录 <code>VERSION.md</code> 在构建时读取并渲染，与首页版本号保持一致。</p>
  </div>
  <dl class="changelog-stats" aria-label="版本概览">
    {stats.map(({ label, value }) => (
      <div class="changelog-stats__item">
        <dt class="changelog-stats__label">{label}</dt>
        <dd class="changelog-stats__value">{value}</dd>
      </div>
    ))}
  </dl>
</section>

{
  entries.length === 0 ? (
    <div class="catalog-note" role="note">
      <strong>暂无记录</strong>
      <span>请在仓库根目录 <code>VERSION.md</code> 的 Changelog 区块补充更新条目。</span>
    </div>
  ) : (
    <section class="changelog-timeline" aria-label="版本更新记录">
      {entries.map((entry) => {
        const current = isCurrentVersion(entry.version, version);
        return (
          <article class:list={['changelog-entry', { 'changelog-entry--current': current }]}>
            <header class="changelog-entry__head">
              <time class="changelog-entry__date" datetime={entry.date}>{entry.date}</time>
              {entry.version && <span class="changelog-entry__version">{entry.version}</span>}
              {current && <span class="changelog-entry__badge">当前</span>}
            </header>
            <ul class="changelog-entry__list">
              {entry.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        );
      })}
    </section>
  )
}
