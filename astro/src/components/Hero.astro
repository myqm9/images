---
import { Image } from 'astro:assets';
import { loadVersionInfo } from '../lib/version.mjs';

const PAGE_TITLE_ID = '_top';
const CHANGELOG_PATH = '/changelog/';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const { version } = loadVersionInfo();

const imageAttrs = {
  loading: 'eager' as const,
  decoding: 'async' as const,
  width: 640,
  height: 400,
  alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
  if ('file' in image) darkImage = image.file;
  else if ('dark' in image) {
    darkImage = image.dark;
    lightImage = image.light;
  } else rawHtml = image.html;
}
---

<div class="hero">
  {darkImage && <Image src={darkImage} {...imageAttrs} class:list={{ 'light:sl-hidden': Boolean(lightImage) }} />}
  {lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
  {rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {(actions.length > 0 || version) && (
      <div class="sl-flex actions hero-actions">
        {actions.map(({ attrs: { class: className, ...attrs } = {}, link: href, text, variant }) => (
          <a href={href} class:list={['sl-link-button', variant, className]} {...attrs}>
            {text}
            <span aria-hidden="true">→</span>
          </a>
        ))}
        {version && (
          <a class="hero-release" href={CHANGELOG_PATH} aria-label={`当前版本 ${version}，查看更新日志`}>
            <span class="hero-release__rule" aria-hidden="true"></span>
            <span class="hero-release__copy">
              <span class="hero-release__label">版本</span>
              <span class="hero-release__value">{version}</span>
            </span>
          </a>
        )}
      </div>
    )}
  </div>
</div>

<style>
  @layer starlight.core {
    .hero { display: grid; align-items: center; gap: 1rem; padding-bottom: 1rem; min-width: 0; }
    .hero > img, .hero > .hero-html { object-fit: contain; width: min(100%, 20rem); max-width: 100%; height: auto; margin-inline: auto; min-width: 0; }
    .stack { flex-direction: column; gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem); text-align: center; min-width: 0; }
    .copy { flex-direction: column; gap: 1rem; align-items: center; min-width: 0; }
    .copy > * { max-width: min(50ch, 100%); }
    h1 { font-size: clamp(var(--sl-text-3xl), calc(.25rem + 5vw), var(--sl-text-6xl)); line-height: var(--sl-line-height-headings); font-weight: 600; color: var(--sl-color-white); overflow-wrap: anywhere; }
    .tagline { font-size: clamp(var(--sl-text-base), calc(.0625rem + 2vw), var(--sl-text-xl)); color: var(--sl-color-gray-2); }
    .actions { gap: 1rem 2rem; flex-wrap: wrap; justify-content: center; max-width: 100%; }
    .sl-link-button { align-items: center; border: 1px solid transparent; border-radius: 999rem; display: inline-flex; font-size: var(--sl-text-sm); gap: .5em; line-height: 1.1875; outline-offset: .25rem; padding: .4375rem 1.125rem; text-decoration: none; }
    .sl-link-button.primary { color: var(--sl-color-black); background: var(--sl-color-text-accent); border-color: var(--sl-color-text-accent); }
    .sl-link-button.secondary { color: var(--sl-color-white); border-color: currentColor; }
    .sl-link-button.minimal { color: var(--sl-color-white); padding-inline: 0; }
    @media (min-width: 50rem) {
      .hero { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 3%; padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem); }
      .hero > img, .hero > .hero-html { order: 2; width: min(100%, 25rem); }
      .stack { text-align: start; }
      .copy { align-items: flex-start; }
      .actions { justify-content: flex-start; }
      .sl-link-button { font-size: var(--sl-text-base); padding: .9375rem 1.25rem; }
    }
  }
</style>
