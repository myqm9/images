---
import releases from '../data/releases/release.json';
import {
  parseMiddlewareRouteId,
  switchableVersions,
  versionPageUrl,
} from '../lib/middleware-versions.mjs';

const PAGE_TITLE_ID = '_top';
const defaultDocs = import.meta.glob('../../docs/middleware/*.md');
const versionDocs = import.meta.glob('../../docs/middleware/*/*.md');

function componentUsesVersionDir(component) {
  return Object.keys(versionDocs).some((path) => path.includes(`/middleware/${component}/`));
}

function hasVersionPage(component, versionId) {
  const release = releases[component];
  if (!release) return false;
  if (Object.keys(versionDocs).some((path) => path.endsWith(`/middleware/${component}/${versionId}.md`))) return true;
  if (versionId !== release.version) return false;
  return Object.keys(defaultDocs).some((path) => path.endsWith(`/middleware/${component}.md`));
}

const { title } = Astro.locals.starlightRoute.entry.data;
const parsed = parseMiddlewareRouteId(Astro.locals.starlightRoute.id);
const versions = parsed ? switchableVersions(parsed.component, hasVersionPage) : [];
const nested = parsed ? componentUsesVersionDir(parsed.component) : false;
---

<div class="tdp-page-title">
  <h1 id={PAGE_TITLE_ID}>{title}</h1>
  {
    parsed && versions.length > 1 && (
      <tdp-version-switch class="tdp-version-switch">
        <label>
          <span class="tdp-version-switch__label">版本：</span>
          <select autocomplete="off" aria-label="选择组件版本">
            {versions.map((entry) => (
              <option
                value={versionPageUrl(parsed.component, entry.id, { nested })}
                selected={entry.id === parsed.versionId}
                title={entry.note || undefined}
              >
                {entry.id}
              </option>
            ))}
          </select>
        </label>
      </tdp-version-switch>
    )
  }
</div>

<script>
  class TdpVersionSwitch extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector('select');
      if (!select) return;
      select.addEventListener('change', () => {
        if (select.value) window.location.assign(select.value);
      });
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) return;
        const markupSelectedIndex = select.querySelector<HTMLOptionElement>('option[selected]')?.index;
        if (markupSelectedIndex !== undefined && markupSelectedIndex !== select.selectedIndex) {
          select.selectedIndex = markupSelectedIndex;
        }
      });
    }
  }

  customElements.define('tdp-version-switch', TdpVersionSwitch);
</script>
