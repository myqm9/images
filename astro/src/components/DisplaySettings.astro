<tdp-display-settings>
<div class="display-settings">
  <button class="settings-trigger" type="button" aria-label="布局切换" aria-haspopup="dialog" title="布局切换">
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5.7c2.5-1.3 5-.8 7 1.1v11.5c-2-1.9-4.5-2.4-7-1.1V5.7Zm16 0c-2.5-1.3-5-.8-7 1.1v11.5c2-1.9 4.5-2.4 7-1.1V5.7Z" /></svg>
  </button>
  <div class="settings-panel">
    <div class="settings-heading"><strong>布局切换</strong><span>个性化阅读体验</span></div>
    <section>
      <h2>主题色</h2>
      <div class="swatches" role="group" aria-label="主题色">
        <button data-setting="palette" data-value="purple"><i></i>紫藤色</button>
        <button data-setting="palette" data-value="blue"><i></i>深海蓝</button>
        <button data-setting="palette" data-value="green"><i></i>松石绿</button>
      </div>
    </section>
    <section>
      <h2>背景效果</h2>
      <div class="segmented" role="group" aria-label="背景效果">
        <button data-setting="surface" data-value="soft">柔和</button>
        <button data-setting="surface" data-value="spotlight">聚光</button>
      </div>
    </section>
  </div>
</div>

<script>
  type Setting = 'palette' | 'surface';
  const root = document.documentElement;
  const storagePrefix = 'tdp-display-';

  const refresh = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-setting]').forEach((button) => {
      const setting = button.dataset.setting as Setting;
      const value = button.dataset.value;
      const current = root.dataset[`tdp${setting[0].toUpperCase()}${setting.slice(1)}`] || 'default';
      button.classList.toggle('is-selected', current === value);
    });
  };

  const initialize = () => {
    localStorage.removeItem(`${storagePrefix}layout`);
    (['palette', 'surface'] as Setting[]).forEach((setting) => {
      const stored = localStorage.getItem(`${storagePrefix}${setting}`);
      if (stored) root.dataset[`tdp${setting[0].toUpperCase()}${setting.slice(1)}`] = stored;
    });
    refresh();
  };

  class TdpDisplaySettings extends HTMLElement {
    connectedCallback() {
      initialize();
      this.querySelectorAll<HTMLButtonElement>('[data-setting]').forEach((button) => {
        button.addEventListener('click', () => {
          const setting = button.dataset.setting as Setting;
          const value = button.dataset.value || '';
          root.dataset[`tdp${setting[0].toUpperCase()}${setting.slice(1)}`] = value;
          localStorage.setItem(`${storagePrefix}${setting}`, value);
          refresh();
        });
      });
    }
  }
  customElements.define('tdp-display-settings', TdpDisplaySettings);
</script>

</tdp-display-settings>

<style>
  .display-settings { position: relative; }
  .settings-trigger { display: grid; width: 1.85rem; height: 1.85rem; place-items: center; padding: 0; color: var(--sl-color-gray-2); background: transparent; border: 0; cursor: pointer; }
  .settings-trigger:hover, .display-settings:focus-within .settings-trigger { color: var(--sl-color-text-accent); }
  .settings-trigger svg { width: 1.32rem; height: 1.32rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; }
  .settings-panel { position: absolute; z-index: 40; top: calc(100% + .65rem); right: 0; width: 19rem; padding: 1rem; color: var(--sl-color-gray-1); pointer-events: none; visibility: hidden; opacity: 0; transform: translateY(-.25rem); background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline-light); border-radius: .85rem; box-shadow: 0 1rem 2.5rem rgba(24, 11, 30, .2); transition: opacity .14s ease, transform .14s ease, visibility .14s ease; }
  .display-settings:hover .settings-panel, .display-settings:focus-within .settings-panel { pointer-events: auto; visibility: visible; opacity: 1; transform: translateY(0); }
  .settings-heading { display: grid; gap: .14rem; padding: .1rem .1rem .8rem; border-bottom: 1px solid var(--sl-color-hairline-light); }
  .settings-heading strong { color: var(--sl-color-white); font-size: .95rem; }
  .settings-heading span { color: var(--sl-color-gray-3); font-size: .75rem; }
  section { padding-top: .85rem; }
  h2 { margin: 0 0 .45rem; color: var(--sl-color-gray-2); font-size: .78rem; font-weight: 650; }
  .segmented { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: .25rem; padding: .2rem; background: var(--sl-color-gray-6); border-radius: .45rem; }
  button { min-height: 1.85rem; padding: .25rem .35rem; color: var(--sl-color-gray-2); font: inherit; font-size: .76rem; background: transparent; border: 0; border-radius: .32rem; cursor: pointer; }
  button:hover { color: var(--sl-color-text-accent); }
  button.is-selected { color: var(--sl-color-text-accent); font-weight: 700; background: var(--sl-color-bg); box-shadow: 0 1px 3px rgba(20, 8, 26, .2); }
  .swatches { display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem; }
  .swatches button { display: grid; justify-items: center; gap: .3rem; padding: .45rem .25rem; border: 1px solid var(--sl-color-hairline-light); }
  .swatches button.is-selected { border-color: var(--sl-color-accent); box-shadow: none; }
  .swatches i { display: block; width: 1.2rem; height: 1.2rem; border-radius: .28rem; background: #76268c; }
  .swatches button:nth-child(2) i { background: #2454a8; }
  .swatches button:nth-child(3) i { background: #0d8060; }
</style>
